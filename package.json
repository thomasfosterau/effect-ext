{
  "$schema": "https://www.schemastore.org/package",
  "name": "effect-ext-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for @thomasfosterau/effect-ext (extensions to the Effect standard library) and the @thomasfosterau/effect-ai-* providers (extensions to Effect's AI module).",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "type": "module",
  "scripts": {
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint --tsrs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/docgen": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@enfect/oxlint": "catalog:",
    "@thomasfosterau/effect-ext": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "lts"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
