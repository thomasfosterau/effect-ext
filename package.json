{
  "name": "effect-ext",
  "version": "0.0.0",
  "description": "A collection of experimental Effect standard library extensions and additions.",
  "keywords": [
    "allocator",
    "arraybuffer",
    "effect",
    "struct-of-arrays",
    "typescript",
    "utf8"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-ext#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-ext/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-ext.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./Allocator": "./dist/Allocator.mjs",
    "./BufferStruct": "./dist/BufferStruct.mjs",
    "./Layout": "./dist/Layout.mjs",
    "./Str": "./dist/Str.mjs",
    "./String": "./dist/String.mjs",
    "./StructOfArrays": "./dist/StructOfArrays.mjs",
    "./Vec": "./dist/Vec.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vp pack --watch",
    "test": "vp test",
    "changeset": "changeset",
    "version": "changeset version && vp fmt && pnpm install --lockfile-only",
    "release": "vp run build && pnpm publish --access public --no-git-checks --ignore-scripts && changeset tag",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/vitest": "catalog:",
    "@enfect/oxlint": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.18.0"
}
