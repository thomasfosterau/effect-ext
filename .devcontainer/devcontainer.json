{
  "name": "effect-ext",
  // Tag matches the catalog's `vite-plus`; Dependabot keeps it current.
  "image": "ghcr.io/voidzero-dev/vite-plus:1.8.0",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "postCreateCommand": "vp install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": ["Anthropic.claude-code", "oxc.oxc-vscode"]
    }
  },
  "workspaceFolder": "/workspaces/effect-ext"
}
