{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/effect-utilities/src/Allocator.ts",
    "packages/effect-utilities/src/Ast.ts",
    "packages/effect-utilities/src/Bounded.ts",
    "packages/effect-utilities/src/BufferStruct.ts",
    "packages/effect-utilities/src/Ids.ts",
    "packages/effect-utilities/src/Issues.ts",
    "packages/effect-utilities/src/Layout.ts",
    "packages/effect-utilities/src/LiteralExact.ts",
    "packages/effect-utilities/src/Str.ts",
    "packages/effect-utilities/src/String.ts",
    "packages/effect-utilities/src/StructOfArrays.ts",
    "packages/effect-utilities/src/TriState.ts",
    "packages/effect-utilities/src/Url.ts",
    "packages/effect-utilities/src/Vec.ts",
    "packages/*/tests/**/*.test.ts",
    "packages/*/tests/**/*.types.ts",
    "tests/dist-consumer/src/*.ts",
    "packages/*/src/index.ts",
    "packages/effect-ai-ext/entries/*.ts",
    "packages/effect-ai-ext/src/*Model.ts",
    "packages/effect-evals/src/cli/main.ts",
    "packages/effect-evals/src/cli/loader.mjs",
    "packages/effect-evals/bin/effect-evals.js",
    "packages/effect-evals/tests/fixtures/**",
    "**/vite.config.ts",
    "vite.package.ts",
    "scripts/check-dist.mjs"
  ],
  "ignorePatterns": ["**/dist/**", "**/docs/**", "**/coverage/**"],
  "ignoreDependencies": [
    "@types/node",
    "@effect/docgen",
    "@effect/tsgo",
    "@effect/language-service",
    "@typescript/native",
    "typescript",
    "tsx",
    "vite",
    "vitest",
    "vite-plus",
    "@changesets/cli",
    "@changesets/changelog-github",
    "@vitest/coverage-istanbul",
    "fallow",
    "@enfect/oxlint"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      {
        "name": "effect-utilities",
        "patterns": ["packages/effect-utilities/**"]
      },
      {
        "name": "dist-consumer",
        "patterns": ["tests/dist-consumer/**"]
      },
      {
        "name": "ai-ext",
        "patterns": ["packages/effect-ai-ext/**"]
      },
      {
        "name": "gateway",
        "patterns": ["packages/effect-ai-gateway/**"]
      },
      {
        "name": "mistral",
        "patterns": ["packages/effect-ai-mistral/**"]
      },
      {
        "name": "cohere",
        "patterns": ["packages/effect-ai-cohere/**"]
      },
      {
        "name": "voyage",
        "patterns": ["packages/effect-ai-voyage/**"]
      },
      {
        "name": "elevenlabs",
        "patterns": ["packages/effect-ai-elevenlabs/**"]
      },
      {
        "name": "evals",
        "patterns": ["packages/effect-evals/**"]
      }
    ],
    "rules": [
      {
        "from": "effect-utilities",
        "allow": []
      },
      {
        "from": "dist-consumer",
        "allow": ["effect-utilities"]
      },
      {
        "from": "ai-ext",
        "allow": []
      },
      {
        "from": "gateway",
        "allow": ["ai-ext"]
      },
      {
        "from": "mistral",
        "allow": []
      },
      {
        "from": "cohere",
        "allow": ["ai-ext"]
      },
      {
        "from": "voyage",
        "allow": ["ai-ext"]
      },
      {
        "from": "elevenlabs",
        "allow": ["ai-ext"]
      },
      {
        "from": "evals",
        "allow": []
      }
    ]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "coverage/coverage-final.json"
  },
  // Each AI package's tests/helpers/effect.ts is the one shared harness shape,
  // copied whole into every package so a suite can reach for any helper; a
  // package whose suite does not use one yet still carries it. The AI modules
  // export the same short names (`make`, `layer`, `Options`, `contramap`);
  // the barrels re-export each module as a namespace (`MistralClient.layer`),
  // so the shared names are the API shape, not a duplicate.
  "ignoreExports": [
    {
      "file": "packages/*/tests/helpers/effect.ts",
      "exports": ["runTestExit", "recordingTracer", "RecordedSpan", "RecordingTracer"]
    },
    {
      "file": "packages/effect-ai-*/src/*.ts",
      "exports": ["make", "layer", "Options", "contramap"]
    },
    {
      "file": "packages/effect-evals/src/*.ts",
      "exports": ["make", "layer", "Options", "contramap"]
    }
  ]
}
