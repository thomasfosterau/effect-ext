{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/effect-utilities/src/*.ts",
    "packages/*/tests/**/*.test.ts",
    "packages/*/tests/**/*.types.ts",
    "tests/dist-consumer/src/*.ts",
    "packages/*/src/index.ts",
    "packages/effect-ai-ext/entries/*.ts",
    "packages/effect-ai-ext/src/*Model.ts",
    "packages/effect-evals/src/cli/main.ts",
    "packages/effect-evals/src/cli/loader.mjs",
    "packages/effect-evals/bin/effect-evals.js",
    "packages/effect-evals/tests/fixtures/**",
    "**/vite.config.ts",
    "vite.package.ts",
    "scripts/check-dist.mjs",
    "scripts/generate-language-subtag-registry.mjs"
  ],
  "ignorePatterns": ["**/dist/**", "**/docs/**", "**/coverage/**"],
  "ignoreDependencies": [
    "@types/node",
    "@effect/docgen",
    "@effect/tsgo",
    "@effect/language-service",
    "@typescript/native",
    "typescript",
    "tsx",
    "vite",
    "vitest",
    "vite-plus",
    "@changesets/cli",
    "@changesets/changelog-github",
    "@vitest/coverage-istanbul",
    "fallow",
    "@enfect/oxlint"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      {
        "name": "effect-utilities",
        "patterns": ["packages/effect-utilities/**"]
      },
      {
        "name": "dist-consumer",
        "patterns": ["tests/dist-consumer/**"]
      },
      {
        "name": "ai-ext",
        "patterns": ["packages/effect-ai-ext/**"]
      },
      {
        "name": "gateway",
        "patterns": ["packages/effect-ai-gateway/**"]
      },
      {
        "name": "mistral",
        "patterns": ["packages/effect-ai-mistral/**"]
      },
      {
        "name": "cohere",
        "patterns": ["packages/effect-ai-cohere/**"]
      },
      {
        "name": "voyage",
        "patterns": ["packages/effect-ai-voyage/**"]
      },
      {
        "name": "elevenlabs",
        "patterns": ["packages/effect-ai-elevenlabs/**"]
      },
      {
        "name": "evals",
        "patterns": ["packages/effect-evals/**"]
      }
    ],
    "rules": [
      {
        "from": "effect-utilities",
        "allow": []
      },
      {
        "from": "dist-consumer",
        "allow": ["effect-utilities"]
      },
      {
        "from": "ai-ext",
        "allow": []
      },
      {
        "from": "gateway",
        "allow": ["ai-ext"]
      },
      {
        "from": "mistral",
        "allow": []
      },
      {
        "from": "cohere",
        "allow": ["ai-ext"]
      },
      {
        "from": "voyage",
        "allow": ["ai-ext"]
      },
      {
        "from": "elevenlabs",
        "allow": ["ai-ext"]
      },
      {
        "from": "evals",
        "allow": []
      }
    ]
  },
  // `pipe` is the Effect `Pipeable` protocol. On effect-utilities' numeric
  // `Value` (src/internal/numeric/value.ts), the base class of `Ratio` and
  // `Complex`, consumers call it through the public interfaces
  // (tests/numeric/Pipeable.test.ts), which fallow does not trace.
  "usedClassMembers": ["pipe"],
  "duplicates": {
    // Reviewed clones, carried from thomasfosterau/effect-numeric (whose
    // fingerprints changed with the reformat at the merge). A content change
    // produces a new fingerprint and makes the group reportable again.
    // - The per-type instance lists (`I8` … `U128`, one documented export
    //   each) that `Saturating` / `Wrapping` and `Checked` / `Overflowing`
    //   expose, mirroring Rust's per-type impls.
    // - `FixedInt`'s `number` and `bigint` primitive tables, whose bitwise
    //   operations read the same over two representations.
    "ignoredClones": ["dup:b85a7ed1:2", "dup:d06606dc:2", "dup:bb9236f0:2"]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "coverage/coverage-final.json"
  },
  // Each AI package's tests/helpers/effect.ts is the one shared harness shape,
  // copied whole into every package so a suite can reach for any helper; a
  // package whose suite does not use one yet still carries it. The AI modules
  // export the same short names (`make`, `layer`, `Options`, `contramap`);
  // the barrels re-export each module as a namespace (`MistralClient.layer`),
  // so the shared names are the API shape, not a duplicate.
  "ignoreExports": [
    {
      "file": "packages/*/tests/helpers/effect.ts",
      "exports": ["runTestExit", "recordingTracer", "RecordedSpan", "RecordingTracer"]
    },
    {
      "file": "packages/effect-ai-*/src/*.ts",
      "exports": ["make", "layer", "Options", "contramap"]
    },
    {
      "file": "packages/effect-evals/src/*.ts",
      "exports": ["make", "layer", "Options", "contramap"]
    },
    // effect-utilities' `Browser` / `BrowserTesting` modules (merged in from
    // effect-web) share one service shape, re-exported as namespaces from
    // their subpath barrels (`Locks.layer`, `TestLocks.Control`).
    {
      "file": "packages/effect-utilities/src/browser/*.ts",
      "exports": ["make", "layer", "changes", "requestPermission", "withLock", "watch"]
    },
    // `Css` re-exports each of its modules as a namespace, so `Color.parse`,
    // `Font.parse` and `Length.parse` (and `serialize`) are one API shape;
    // `internal/web/dom.ts`'s `watch` is the helper `IdleDetection.watch`
    // shares a name with, never imported side by side.
    {
      "file": "packages/effect-utilities/src/css/*.ts",
      "exports": ["parse", "serialize"]
    },
    {
      "file": "packages/effect-utilities/src/internal/web/dom.ts",
      "exports": ["watch"]
    },
    {
      "file": "packages/effect-utilities/src/browser-testing/*.ts",
      "exports": ["make", "layer", "Control", "Fixture", "Options"]
    }
  ]
}
