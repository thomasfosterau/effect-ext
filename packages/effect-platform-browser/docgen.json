{
  "$schema": "../../node_modules/@effect/docgen/schema.json",
  "runExamples": true,
  "srcLink": "https://github.com/thomasfosterau/effect-ext/blob/trunk/packages/effect-platform-browser/src/",
  "enforceVersion": false,
  "exclude": ["src/index.ts", "src/internal/**/*.ts", "src/BrowserTesting.ts"],
  "parseCompilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "exactOptionalPropertyTypes": false,
    "types": ["node"]
  },
  "examplesCompilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "exactOptionalPropertyTypes": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "paths": {
      "@thomasfosterau/effect-platform-worker-shared": [
        "../../../effect-platform-worker-shared/dist/index"
      ],
      "@thomasfosterau/effect-platform-worker-shared/*": [
        "../../../effect-platform-worker-shared/dist/*"
      ],
      "@thomasfosterau/effect-ext": ["../../../effect-ext/dist/index"],
      "@thomasfosterau/effect-ext/*": ["../../../effect-ext/dist/*"],
      "@thomasfosterau/effect-platform-browser": ["../../dist/index"],
      "@thomasfosterau/effect-platform-browser/*": ["../../dist/*"]
    }
  }
}
