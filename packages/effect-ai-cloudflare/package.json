{
  "name": "@thomasfosterau/effect-ai-cloudflare",
  "version": "0.2.0",
  "description": "Cloudflare AI for Effect: @effect/ai-cloudflare's Workers AI decision models and client, routed through a Cloudflare AI Gateway, plus Anthropic, Cohere and OpenAI moderation through the gateway's Worker binding or public HTTPS endpoint, BYOK.",
  "keywords": [
    "ai",
    "ai-gateway",
    "anthropic",
    "byok",
    "cloudflare",
    "cohere",
    "decision-model",
    "effect",
    "moderation",
    "openai",
    "reranker",
    "workers-ai"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-ext/tree/trunk/packages/effect-ai-cloudflare#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-ext/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-ext.git",
    "directory": "packages/effect-ai-cloudflare"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/effect-ext": "workspace:^"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/ai-anthropic": "catalog:",
    "@effect/ai-cloudflare": "catalog:",
    "@effect/language-service": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "catalog:peers",
    "@effect/ai-anthropic": "catalog:peers",
    "@effect/ai-cloudflare": "catalog:ai-cloudflare-peers",
    "effect": "catalog:ai-cloudflare-peers"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  }
