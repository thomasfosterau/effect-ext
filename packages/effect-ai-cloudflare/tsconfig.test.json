{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  // The tests, type-checked by `vp run check` (`tsc -p tsconfig.test.json`
  // after `tsconfig.json`'s `src`). The package resolves itself and its
  // siblings by name through their development `exports` (`src/`).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src", "tests"]
}
