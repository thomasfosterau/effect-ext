{
  "name": "@thomasfosterau/effect-platform-worker-shared",
  "version": "0.0.0",
  "description": "Effect platform utilities shared by every web worker scope: the worker global as a context reference, a worker runMain, and schema-typed message ports.",
  "keywords": [
    "effect",
    "web-worker",
    "worker"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-ext/tree/trunk/packages/effect-platform-worker-shared#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-ext/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-ext.git",
    "directory": "packages/effect-platform-worker-shared"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./WorkerScope": "./src/WorkerScope.ts",
    "./WorkerRuntime": "./src/WorkerRuntime.ts",
    "./WorkerMessaging": "./src/WorkerMessaging.ts",
    "./Performance": "./src/Performance.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./WorkerScope": {
        "types": "./dist/WorkerScope.d.ts",
        "import": "./dist/WorkerScope.js"
      },
      "./WorkerRuntime": {
        "types": "./dist/WorkerRuntime.d.ts",
        "import": "./dist/WorkerRuntime.js"
      },
      "./WorkerMessaging": {
        "types": "./dist/WorkerMessaging.d.ts",
        "import": "./dist/WorkerMessaging.js"
      },
      "./Performance": {
        "types": "./dist/Performance.d.ts",
        "import": "./dist/Performance.js"
      }
    },
    "access": "public"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  }
}
