    "./WorkerScope": "./src/WorkerScope.ts",
    "./WorkerRuntime": "./src/WorkerRuntime.ts",
    "./WorkerMessaging": "./src/WorkerMessaging.ts",
    "./CookieStore": "./src/CookieStore.ts",
    "./EventSource": "./src/EventSource.ts",
    "./Performance": "./src/Performance.ts",
    "./TaskScheduler": "./src/TaskScheduler.ts",
    "./BrowserFileSystem": "./src/BrowserFileSystem.ts",
    "./MemoryFileSystemHandle": "./src/MemoryFileSystemHandle.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./AppBadge": {
        "types": "./dist/AppBadge.d.ts",
        "import": "./dist/AppBadge.js"
      },
      "./Serial": {
        "types": "./dist/Serial.d.ts",
        "import": "./dist/Serial.js"
      },
      "./WorkerScope": {
        "types": "./dist/WorkerScope.d.ts",
        "import": "./dist/WorkerScope.js"
      },
      "./WorkerRuntime": {
        "types": "./dist/WorkerRuntime.d.ts",
        "import": "./dist/WorkerRuntime.js"
      },
      "./WorkerMessaging": {
        "types": "./dist/WorkerMessaging.d.ts",
        "import": "./dist/WorkerMessaging.js"
      },
      "./CookieStore": {
        "types": "./dist/CookieStore.d.ts",
        "import": "./dist/CookieStore.js"
      },
      "./EventSource": {
        "types": "./dist/EventSource.d.ts",
        "import": "./dist/EventSource.js"
      },
      "./Performance": {
        "types": "./dist/Performance.d.ts",
        "import": "./dist/Performance.js"
      },
      "./TaskScheduler": {
        "types": "./dist/TaskScheduler.d.ts",
        "import": "./dist/TaskScheduler.js"
      },
      "./BrowserFileSystem": {
        "types": "./dist/BrowserFileSystem.d.ts",
        "import": "./dist/BrowserFileSystem.js"
      },
      "./MemoryFileSystemHandle": {
        "types": "./dist/MemoryFileSystemHandle.d.ts",
        "import": "./dist/MemoryFileSystemHandle.js"
      }
