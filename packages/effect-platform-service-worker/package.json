{
  "name": "@thomasfosterau/effect-platform-service-worker",
  "version": "0.2.0",
  "description": "Effect platform utilities for service workers.",
  "keywords": [
    "effect",
    "pwa",
    "service-worker"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-ext/tree/trunk/packages/effect-platform-service-worker#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-ext/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-ext.git",
    "directory": "packages/effect-platform-service-worker"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Caches": "./src/Caches.ts",
    "./Clients": "./src/Clients.ts",
    "./CookieSubscriptions": "./src/CookieSubscriptions.ts",
    "./Events": "./src/Events.ts",
    "./Fetch": "./src/Fetch.ts",
    "./NavigationPreload": "./src/NavigationPreload.ts",
    "./Notifications": "./src/Notifications.ts",
    "./ServiceWorkerRunner": "./src/ServiceWorkerRunner.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./Caches": {
        "types": "./dist/Caches.d.ts",
        "import": "./dist/Caches.js"
      },
      "./Clients": {
        "types": "./dist/Clients.d.ts",
        "import": "./dist/Clients.js"
      },
      "./CookieSubscriptions": {
        "types": "./dist/CookieSubscriptions.d.ts",
        "import": "./dist/CookieSubscriptions.js"
      },
      "./Events": {
        "types": "./dist/Events.d.ts",
        "import": "./dist/Events.js"
      },
      "./Fetch": {
        "types": "./dist/Fetch.d.ts",
        "import": "./dist/Fetch.js"
      },
      "./NavigationPreload": {
        "types": "./dist/NavigationPreload.d.ts",
        "import": "./dist/NavigationPreload.js"
      },
      "./Notifications": {
        "types": "./dist/Notifications.d.ts",
        "import": "./dist/Notifications.js"
      },
      "./ServiceWorkerRunner": {
        "types": "./dist/ServiceWorkerRunner.d.ts",
        "import": "./dist/ServiceWorkerRunner.js"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/effect-platform-worker-shared": "workspace:*"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:platform-peers"
  }
