{
  "$schema": "../../node_modules/@effect/docgen/schema.json",
  "exclude": [
    "src/index.ts",
    "src/internal/**",
    "src/Browser.ts",
    "src/BrowserTesting.ts",
    "src/Css.ts",
    "src/Encoding.ts",
    "src/Langtag.ts",
    "src/Mime.ts",
    "src/UriTemplate.ts",
    "src/Web.ts"
  ],
  "runExamples": true,
  "parseCompilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "exactOptionalPropertyTypes": true
  },
  "examplesCompilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"],
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  }
}
