{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-utilities",
  "version": "0.0.0",
  "description": "Extensions to the Effect standard library: Allocator-backed binary data (layouts, buffer structs, vectors, struct-of-arrays, Rust-style UTF-8 strings), Schema helpers (the update tri-state, issue → RFC 6901 JSON Pointer, bounded codecs, ids, exact literal tuples, introspection, typed URLs), and web-platform building blocks (request/response policies, SSRF-safe fetch, content negotiation, service workers, browser APIs as services, robots.txt, sitemaps, RSS / Atom / JSON Feed, URI Templates, BCP 47 language tags, CSS parsing, WHATWG encodings and MIME types).",
  "keywords": [
    "allocator",
    "arraybuffer",
    "atom",
    "bcp47",
    "browser",
    "css",
    "effect",
    "effect-schema",
    "encoding",
    "json-feed",
    "json-pointer",
    "mime",
    "pagination",
    "rfc6901",
    "robots-txt",
    "rss",
    "schema",
    "service-worker",
    "sitemap",
    "slug",
    "struct-of-arrays",
    "typescript",
    "uri-template",
    "url",
    "utf8",
    "uuid",
    "web"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-ext#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-ext/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-ext.git",
    "directory": "packages/effect-utilities"
